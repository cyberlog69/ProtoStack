# Public origin used for canonical URLs, sitemap.xml and robots.txt.
# This value is baked into static pages at BUILD time; rebuild after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "standalone" to produce the container-friendly server output.
# NEXT_OUTPUT=standalone

# Comma-separated allowlist for the /api/http-test outbound proxy.
# Narrow this on a public deployment.
HTTP_TEST_ALLOWED_HOSTS=example.com,www.example.com,httpbin.org,jsonplaceholder.typicode.com
