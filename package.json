  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/data.test.ts tests/coverage.test.ts tests/url-safety.test.ts tests/content.test.ts tests/layouts.test.ts tests/attacks.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "ingest": "node scripts/ingest-protocols.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.13.0",
