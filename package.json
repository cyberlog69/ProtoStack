{
  "name": "proto-stack",
  "version": "0.1.0",
  "description": "Interactive networking, internet, and IoT protocol learning platform with animated packet-flow models, honestly labelled sandboxes, OSI/TCP-IP layer views, comparisons, and quizzes.",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/data.test.ts tests/url-safety.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "ingest": "node scripts/ingest-protocols.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.8.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
